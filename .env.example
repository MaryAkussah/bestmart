# Copy this file to .env and fill in the values from your Supabase project:
# Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only secret for the Express API in server/ — deliberately NOT
# prefixed VITE_, since Vite inlines anything with that prefix into the
# browser bundle. Must never reach the client.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
